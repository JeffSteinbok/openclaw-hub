{
  "id": "package-tracking",
  "name": "Package Tracking",
  "description": "Track packages from UPS, FedEx, USPS, and Amazon",
  "version": "1.0.0",
  "entry": "./dist/adapter.js",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "status_providers": {
        "type": "array",
        "items": { "type": "string" },
        "description": "Paths to external ESM carrier status provider modules"
      }
    }
  },
  "source": {
    "canonicalRepo": "JeffSteinbok/octo",
    "canonicalPath": "plugins/package-tracking",
    "mirrors": [
      {
        "repo": "JeffSteinbok/openclaw-hub",
        "path": "plugins/package-tracking"
      }
    ]
  },
  "activation": {
    "onStartup": true
  }
}