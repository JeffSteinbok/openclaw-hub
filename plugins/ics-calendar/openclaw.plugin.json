{
  "id": "ics-calendar",
  "name": "ICS Calendar",
  "description": "Fetch upcoming events from a published ICS calendar feed",
  "version": "1.0.1",
  "entry": "./dist/adapter.js",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "calendars": {
        "type": "array",
        "items": {
          "type": "object"
        },
        "description": "List of calendar configs with id, label, url"
      }
    }
  },
  "contracts": {
    "tools": [
      "ics_calendar_fetch"
    ]
  },
  "activation": {
    "onStartup": true
  },
  "openclaw": {}
}
