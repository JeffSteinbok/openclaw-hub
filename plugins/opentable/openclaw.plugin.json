{
  "id": "opentable",
  "name": "OpenTable",
  "description": "Look up restaurants, check availability, and monitor health on OpenTable",
  "version": "1.0.0",
  "entry": "dist/index.js",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "availabilityHash": { "type": "string", "description": "Persisted-query hash used for OpenTable availability requests" },
      "notifyChannel": { "type": "string", "description": "Notification channel for heartbeat alerts", "default": "discord" },
      "notifyTarget": { "type": "string", "description": "Notification target for heartbeat alerts" }
    }
  },
  "setup": {
    "providers": [
      {
        "id": "opentable",
        "authMethods": ["public"],
        "envVars": ["OPENTABLE_AVAILABILITY_HASH", "NOTIFY_CHANNEL", "NOTIFY_TARGET"]
      }
    ]
  },
  "activation": {
    "onStartup": true
  }
}
