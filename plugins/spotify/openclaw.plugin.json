{
  "id": "spotify",
  "name": "Spotify",
  "description": "Control Spotify playback, search music, and manage playlists",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "clientId": { "type": "string", "description": "Spotify app client ID" },
      "clientSecret": { "type": "string", "description": "Spotify app client secret" },
      "redirectUri": { "type": "string", "description": "Spotify OAuth redirect URI", "default": "http://127.0.0.1:8888/callback" }
    }
  },
  "setup": {
    "providers": [
      {
        "id": "spotify",
        "authMethods": ["oauth2"],
        "envVars": ["SPOTIFY_CLIENT_ID", "SPOTIFY_CLIENT_SECRET", "SPOTIFY_REDIRECT_URI"]
      }
    ]
  },
  "source": {
    "canonicalRepo": "JeffSteinbok/octo",
    "canonicalPath": "plugins/spotify",
    "mirrors": [
      {
        "repo": "JeffSteinbok/openclaw-hub",
        "path": "plugins/spotify"
      }
    ]
  },
  "version": "1.0.1",
  "activation": {
    "onStartup": true
  }
}
