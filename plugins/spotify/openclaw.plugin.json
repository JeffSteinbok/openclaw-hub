{
  "id": "spotify",
  "name": "Spotify",
  "description": "Control Spotify playback, search music, and manage playlists",
  "version": "1.0.1",
  "entry": "./dist/adapter.js",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "clientId": {
        "type": "string",
        "description": "Spotify app client ID"
      },
      "clientSecret": {
        "type": "string",
        "description": "Spotify app client secret"
      },
      "redirectUri": {
        "type": "string",
        "description": "OAuth2 redirect URI"
      }
    }
  },
  "contracts": {
    "tools": [
      "spotify_now_playing",
      "spotify_play",
      "spotify_pause",
      "spotify_next",
      "spotify_previous",
      "spotify_search",
      "spotify_get_devices",
      "spotify_get_playlists",
      "spotify_add_to_playlist"
    ]
  },
  "activation": {
    "onStartup": true
  },
  "openclaw": {}
}
