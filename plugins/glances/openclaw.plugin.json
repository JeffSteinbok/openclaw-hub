{
  "id": "glances",
  "name": "Glances",
  "description": "Read CPU, memory, disk, and summary metrics from a Glances server",
  "version": "1.0.0",
  "entry": "./dist/adapter.js",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "url": {
        "type": "string",
        "description": "Base URL for the Glances web server, e.g. http://127.0.0.1:61208",
        "default": "http://127.0.0.1:61208"
      }
    }
  },
  "contracts": {
    "tools": [
      "glances_summary_get",
      "glances_cpu_get",
      "glances_memory_get",
      "glances_disk_get",
      "glances_endpoint_get"
    ]
  },
  "activation": {
    "onStartup": true
  },
  "openclaw": {}
}
