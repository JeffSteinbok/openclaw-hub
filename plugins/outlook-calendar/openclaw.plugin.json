{
  "id": "outlook-calendar",
  "name": "Outlook Calendar",
  "description": "Fetch upcoming events from Outlook personal and family calendars",
  "version": "1.0.1",
  "entry": "./dist/adapter.js",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "clientId": {
        "type": "string",
        "description": "Microsoft OAuth client ID"
      },
      "clientSecret": {
        "type": "string",
        "description": "Microsoft OAuth client secret"
      },
      "refreshToken": {
        "type": "string",
        "description": "Microsoft OAuth refresh token"
      }
    }
  },
  "contracts": {
    "tools": [
      "outlook_calendar_fetch"
    ]
  },
  "activation": {
    "onStartup": true
  },
  "openclaw": {}
}
