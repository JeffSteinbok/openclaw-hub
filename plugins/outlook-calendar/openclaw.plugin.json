{
  "id": "outlook-calendar",
  "name": "Outlook Calendar",
  "description": "Fetch upcoming events from Outlook personal and family calendars",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "clientId": {
        "type": "string",
        "description": "Microsoft Graph OAuth2 client ID"
      },
      "clientSecret": {
        "type": "string",
        "description": "Microsoft Graph OAuth2 client secret"
      },
      "refreshToken": {
        "type": "string",
        "description": "Microsoft Graph OAuth2 refresh token"
      },
      "personalCalendarNames": {
        "type": "array",
        "description": "Optional additional Outlook calendar names to try before the built-in personal defaults",
        "items": {
          "type": "string"
        }
      },
      "familyCalendarNames": {
        "type": "array",
        "description": "Optional additional Outlook calendar names to try before the built-in family defaults",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "setup": {
    "providers": [
      {
        "id": "outlook-calendar",
        "authMethods": [
          "oauth2"
        ],
        "envVars": [
          "OUTLOOK_CLIENT_ID",
          "OUTLOOK_CLIENT_SECRET",
          "OUTLOOK_REFRESH_TOKEN",
          "OUTLOOK_PERSONAL_CALENDAR_NAMES",
          "OUTLOOK_FAMILY_CALENDAR_NAMES"
        ]
      }
    ]
  },
  "source": {
    "canonicalRepo": "JeffSteinbok/octo",
    "canonicalPath": "plugins/outlook-calendar",
    "mirrors": [
      {
        "repo": "JeffSteinbok/openclaw-hub",
        "path": "plugins/outlook-calendar"
      }
    ]
  },
  "version": "1.0.1",
  "activation": {
    "onStartup": true
  },
  "entry": "dist/index.js"
}