{
  "id": "outlook-work-calendar",
  "name": "Outlook Work Calendar",
  "version": "1.0.1",
  "description": "Fetch upcoming events from a published Outlook work calendar",
  "entry": "dist/index.js",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "url": {
        "type": "string",
        "description": "Published Outlook work calendar base URL"
      },
      "folderId": {
        "type": "string",
        "description": "EWS folder identifier for the published calendar"
      }
    }
  },
  "setup": {
    "providers": [
      {
        "id": "outlook-work-calendar",
        "authMethods": ["published-link"],
        "envVars": [
          "OUTLOOK_WORK_CALENDAR_URL",
          "OUTLOOK_WORK_FOLDER_ID"
        ]
      }
    ]
  },
  "source": {
    "canonicalRepo": "JeffSteinbok/octo",
    "canonicalPath": "plugins/outlook-work-calendar",
    "mirrors": [
      {
        "repo": "JeffSteinbok/openclaw-hub",
        "path": "plugins/outlook-work-calendar"
      }
    ]
  },
  "activation": {
    "onStartup": true
  }
}
