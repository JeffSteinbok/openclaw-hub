{
  "id": "outlook-mail",
  "name": "Outlook Mail",
  "description": "Search and read messages from Outlook inboxes",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "clientId": {
        "type": "string",
        "description": "Microsoft Graph OAuth2 client ID"
      },
      "clientSecret": {
        "type": "string",
        "description": "Microsoft Graph OAuth2 client secret"
      },
      "refreshToken": {
        "type": "string",
        "description": "Microsoft Graph OAuth2 refresh token"
      }
    }
  },
  "setup": {
    "providers": [
      {
        "id": "outlook-mail",
        "authMethods": ["oauth2"],
        "envVars": [
          "OUTLOOK_CLIENT_ID",
          "OUTLOOK_CLIENT_SECRET",
          "OUTLOOK_REFRESH_TOKEN"
        ]
      }
    ]
  },
  "source": {
    "canonicalRepo": "JeffSteinbok/octo",
    "canonicalPath": "plugins/outlook-mail",
    "mirrors": [
      {
        "repo": "JeffSteinbok/openclaw-hub",
        "path": "plugins/outlook-mail"
      }
    ]
  },
  "version": "1.0.1",
  "activation": {
    "onStartup": true
  }
}
