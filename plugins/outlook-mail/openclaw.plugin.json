{
  "id": "outlook-mail",
  "name": "Outlook Mail",
  "description": "Search and read messages from Outlook inboxes",
  "version": "1.0.1",
  "entry": "./dist/adapter.js",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "clientId": {
        "type": "string",
        "description": "Microsoft OAuth client ID"
      },
      "clientSecret": {
        "type": "string",
        "description": "Microsoft OAuth client secret"
      },
      "refreshToken": {
        "type": "string",
        "description": "Microsoft OAuth refresh token"
      }
    }
  },
  "contracts": {
    "tools": [
      "outlook_inbox",
      "outlook_search",
      "outlook_read",
      "outlook_save_attachments"
    ]
  },
  "activation": {
    "onStartup": true
  },
  "openclaw": {}
}
