{
  "id": "llmvision",
  "name": "Home Assistant – LLM Vision",
  "description": "Home Assistant LLM Vision integration: analyze camera images with AI, query the vision timeline, and create timeline events.",
  "version": "1.0.1",
  "entry": "./dist/adapter.js",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "server": {
        "type": "string",
        "description": "Home Assistant server URL"
      },
      "token": {
        "type": "string",
        "description": "Home Assistant long-lived access token"
      }
    }
  },
  "contracts": {
    "tools": [
      "llmvision_timeline_get",
      "llmvision_get_image",
      "llmvision_analyze_image",
      "llmvision_create_event"
    ]
  },
  "activation": {
    "onStartup": true
  },
  "openclaw": {}
}
