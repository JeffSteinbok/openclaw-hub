{
  "id": "weightwatchers",
  "name": "WeightWatchers",
  "description": "Search foods, log meals, view diary and points budget via the unofficial WW API",
  "version": "1.0.0",
  "entry": "./dist/adapter.js",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "jwt": {
        "type": "string",
        "description": "WW API JWT token (preferred auth method)"
      },
      "email": {
        "type": "string",
        "description": "WW account email used for fallback login"
      },
      "password": {
        "type": "string",
        "description": "WW account password used for fallback login"
      },
      "tld": {
        "type": "string",
        "description": "WW regional TLD (for example `com`)",
        "default": "com"
      }
    }
  },
  "setup": {
    "providers": [
      {
        "id": "weightwatchers",
        "authMethods": [
          "jwt",
          "password"
        ],
        "envVars": [
          "WW_JWT",
          "WW_EMAIL",
          "WW_PASSWORD",
          "WW_TLD"
        ]
      }
    ]
  },
  "activation": {
    "onStartup": true
  },
  "source": {
    "canonicalRepo": "JeffSteinbok/openclaw-hub",
    "canonicalPath": "plugins/weightwatchers"
  }
}
