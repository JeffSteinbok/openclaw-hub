{
  "id": "weightwatchers",
  "name": "WeightWatchers",
  "description": "Search foods, log meals, view diary and points budget via the unofficial WW API",
  "version": "1.0.0",
  "entry": "./dist/adapter.js",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "jwt": {
        "type": "string",
        "description": "WW API JWT token (preferred auth method)"
      },
      "email": {
        "type": "string",
        "description": "WW account email used for fallback login"
      },
      "password": {
        "type": "string",
        "description": "WW account password used for fallback login"
      },
      "tld": {
        "type": "string",
        "description": "WW regional TLD (e.g. 'com')",
        "default": "com"
      }
    }
  },
  "contracts": {
    "tools": [
      "ww_daily",
      "ww_search",
      "ww_log",
      "ww_points",
      "ww_budget",
      "ww_quick_add",
      "ww_delete",
      "ww_search_meals",
      "ww_log_meal"
    ]
  },
  "activation": {
    "onStartup": true
  },
  "openclaw": {}
}
