{
  "id": "withings",
  "name": "Withings",
  "description": "Fetch health data from Withings devices (weight, body composition, heart rate, sleep, activity)",
  "version": "1.0.0",
  "entry": "./dist/adapter.js",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "clientId": {
        "type": "string",
        "description": "Withings OAuth2 client ID"
      },
      "clientSecret": {
        "type": "string",
        "description": "Withings OAuth2 client secret"
      },
      "redirectUri": {
        "type": "string",
        "description": "OAuth2 redirect URI"
      }
    }
  },
  "contracts": {
    "tools": [
      "withings_auth_url",
      "withings_auth_complete",
      "withings_auth_status",
      "withings_tokens",
      "withings_get_measurements",
      "withings_get_activity",
      "withings_get_heart",
      "withings_get_sleep"
    ]
  },
  "activation": {
    "onStartup": true
  },
  "openclaw": {}
}
