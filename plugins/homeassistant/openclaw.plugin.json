{
  "id": "homeassistant",
  "name": "Home Assistant",
  "version": "1.0.1",
  "description": "Control devices, query state, and inspect activity in Home Assistant",
  "entry": "dist/index.js",
  "tools": "src/tools.py",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
