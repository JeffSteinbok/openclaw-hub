{
  "id": "homeassistant",
  "name": "Home Assistant",
  "version": "1.0.1",
  "description": "Control devices, query state, and inspect activity in Home Assistant",
  "entry": "./dist/adapter.js",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "server": {
        "type": "string",
        "description": "Home Assistant server URL"
      },
      "token": {
        "type": "string",
        "description": "Home Assistant long-lived access token"
      }
    }
  },
  "source": {
    "canonicalRepo": "JeffSteinbok/octo",
    "canonicalPath": "plugins/homeassistant",
    "mirrors": [
      {
        "repo": "JeffSteinbok/openclaw-hub",
        "path": "plugins/homeassistant"
      }
    ]
  },
  "activation": {
    "onStartup": true
  },
  "openclaw": {}
}