{
  "id": "homeassistant",
  "name": "Home Assistant",
  "version": "1.0.1",
  "description": "Control devices, query state, and inspect activity in Home Assistant",
  "entry": "dist/index.js",
  "tools": "src/tools.py",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "server": { "type": "string", "description": "Home Assistant server URL" },
      "token": { "type": "string", "description": "Home Assistant long-lived access token" }
    }
  },
  "setup": {
    "providers": [
      {
        "id": "homeassistant",
        "authMethods": ["token"],
        "envVars": ["HASS_SERVER", "HASS_TOKEN"]
      }
    ]
  },
  "source": {
    "canonicalRepo": "JeffSteinbok/octo",
    "canonicalPath": "plugins/homeassistant",
    "mirrors": [
      {
        "repo": "JeffSteinbok/openclaw-hub",
        "path": "plugins/homeassistant"
      }
    ]
  },
  "activation": {
    "onStartup": true
  }
}
