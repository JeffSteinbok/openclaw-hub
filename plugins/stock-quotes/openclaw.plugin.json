{
  "id": "stock-quotes",
  "name": "Stock Quotes",
  "description": "Fetch current stock, ETF, and mutual fund quotes",
  "version": "1.0.1",
  "entry": "dist/index.js",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "finnhubApiKey": { "type": "string", "description": "Optional Finnhub API key" }
    }
  },
  "setup": {
    "providers": [
      {
        "id": "stock-quotes",
        "authMethods": ["apiKey"],
        "envVars": ["FINNHUB_API_KEY"]
      }
    ]
  },
  "source": {
    "canonicalRepo": "JeffSteinbok/octo",
    "canonicalPath": "plugins/stock-quotes",
    "mirrors": [
      {
        "repo": "JeffSteinbok/openclaw-hub",
        "path": "plugins/stock-quotes"
      }
    ]
  },
  "activation": {
    "onStartup": true
  }
}
