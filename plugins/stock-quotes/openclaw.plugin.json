{
  "id": "stock-quotes",
  "name": "Stock Quotes",
  "description": "Fetch current stock, ETF, and mutual fund quotes",
  "version": "1.1.0",
  "entry": "./dist/adapter.js",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "finnhubApiKey": {
        "type": "string",
        "description": "Optional Finnhub API key"
      }
    }
  },
  "source": {
    "canonicalRepo": "JeffSteinbok/octo",
    "canonicalPath": "plugins/stock-quotes",
    "mirrors": [
      {
        "repo": "JeffSteinbok/openclaw-hub",
        "path": "plugins/stock-quotes"
      }
    ]
  },
  "activation": {
    "onStartup": true
  },
  "openclaw": {}
}