{
  "name": "md-to-html",
  "version": "1.0.0",
  "description": "Convert styled Markdown reports to HTML using a CSS template",
  "author": "OpenClaw",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "md-to-html": "./dist/bin/md-to-html.js"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && carapace-generate-cli --entry ./dist/index.js --out ./dist/bin",
    "test": "vitest run"
  },
  "dependencies": {
    "carapace-plugin-sdk": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsup": "^9.0.0",
    "typescript": "^7",
    "vitest": "^5.0.3",
    "@sinclair/typebox": "^0.34.52"
  },
  "peerDependencies": {
    "openclaw": "^2026.4.23"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./dist/adapter.js"
    ]
  }
}
